{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "scripts",
    "test",
    "apps/*/test",
    "packages/*/test",
    "packages/*/scripts",
    "apps/web/vite.config.ts",
    "e2e",
    "playwright.config.ts",
    "video/record"
  ]
}
