  "cards": [
    {
      "dot": "emerald",
      "title": "Core governance rules",
      "items": [
        "Only named people can confirm findings, submit work orders, or approve remedies",
        "AI agents read, propose, and draft paperwork but cannot execute approvals",
        "Independent reviewers verify completed physical repairs on site before pass restoration"
      ]
    },
    {
      "dot": "rose",
      "title": "Enforced policy refusals",
      "items": [
        "agents_draft_only blocks non-human tokens from approving or submitting operations",
        "two_person_rule prohibits the installer or finding creator from re-testing work",
        "one_way_rule ensures only a designated reviewer with an accepted test restores a pass"
      ]
    },
    {
      "dot": "cyan",
      "title": "Township accountability chain",
      "items": [
        "Drones and walk patrols feed identical fixed viewpoints into the Edge Inbox",
        "The park manager triages flags while the drainage engineer approves remedies",
        "The township general manager releases funding and tracks overdue repairs"
      ]
    }
