  "cards": [
    {
      "dot": "emerald",
      "title": "Route closure rule",
      "items": [
        "A route to the water edge is closed only when at least one of its traversed openings is blocked by an approved remedy.",
        "An unknown route stays unknown regardless of what is blocked, preserving suspicion until verified on site.",
        "The policy function routeStatus evaluates each route projection dynamically during remedy selection."
      ]
    },
    {
      "dot": "cyan",
      "title": "Markings and remedy scope",
      "items": [
        "Openings are marked on site inspection photos with opening type and measured width in millimetres.",
        "Routes trace passage from paths, gates or play areas through opening sequences to the water edge.",
        "Proposed remedies specify bill of quantities, acceptance criteria and fixed quotes or quote needed."
      ]
    },
    {
      "dot": "violet",
      "title": "Engineer governance and work order",
      "items": [
        "The engineer confirms marked openings and recorded routes before approving the selected remedy.",
        "Approved remedies automatically transition into formal work orders for township repair crews.",
        "Accepted re-tests verify physical closure of openings before restoring the township edge pass."
      ]
    }
