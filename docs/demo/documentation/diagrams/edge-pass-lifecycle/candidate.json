  "cards": [
    {
      "dot": "emerald",
      "title": "The one-way rule",
      "items": [
        "Only a reviewer with an accepted re-test can make an edge pass valid",
        "System, agent and provider actors can only expire or suspend a pass",
        "Every valid pass is scoped to checked routes and issued for at most 12 months"
      ]
    },
    {
      "dot": "rose",
      "title": "Suspicion suspends",
      "items": [
        "A Tier 2 candidate, damage report, or missed patrol suspends a pass immediately",
        "Suspension is executed by core in the same transaction as the trigger",
        "A suspended pass records what holds it until all open suspicions are resolved"
      ]
    },
    {
      "dot": "amber",
      "title": "Time and renewal",
      "items": [
        "Core tick moves a valid pass to expiring 30 days before its expiry date",
        "A pass expires when validTo is reached without an accepted renewal re-test",
        "An expired pass remains restorable only through an accepted reviewer re-test"
      ]
    }
  ]
