  "cards": [
    {
      "dot": "emerald",
      "title": "One core, two transports",
      "items": [
        "The demo runs core in the page on the labelled Elmina seed, so it needs no backend",
        "The API runs the same core over HTTP"
      ]
    },
    {
      "dot": "rose",
      "title": "The agent cannot approve",
      "items": [
        "The agent reads, proposes and drafts with an agent token",
        "Core refuses it every confirm, accept and sign"
      ]
    },
    {
      "dot": "amber",
      "title": "Simulated, and labelled",
      "items": ["Flights, detections and repairs are simulated", "Every screen carries a SIMULATION label"]
