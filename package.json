{
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter '@safe-edge/web' build",
    "check:browser": "bun scripts/check-browser.ts",
    "dev": "bun --filter '@safe-edge/*' dev",
    "graph": "graphify update .",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "prepare": "husky",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc && bun --filter '@safe-edge/*' typecheck"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3"
  }
}
