{
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent:live": "SAFE_EDGE_CLAUDE=live bun test apps/api/test/agent.test.ts test/guardrails/api.test.ts --timeout 600000",
    "agent:record": "SAFE_EDGE_CLAUDE=record bun test apps/api/test/agent.test.ts test/guardrails/api.test.ts --timeout 600000",
    "build": "bun --filter '@safe-edge/web' build",
    "check:browser": "bun scripts/check-browser.ts",
    "check:qgc-plan": "out=$(mktemp -d) && bun run export:mission \"$out\" && uv run --script packages/planner/scripts/check-qgc-plan.py \"$out\"/*.plan",
    "dev": "bun --filter '@safe-edge/*' dev",
    "dev:token": "bun apps/api/src/dev-tokens.ts",
    "export:mission": "bun packages/planner/scripts/export-mission.ts",
    "fetch:weather": "bun packages/providers/scripts/fetch-weather.ts",
    "generate:contracts": "bun packages/contracts/scripts/generate.ts",
    "generate:seed": "bun packages/core/scripts/generate-seed.ts",
    "graph": "graphify update .",
    "lint": "prettier --check . && bun scripts/check-context-files.ts",
    "lint:fix": "prettier --write .",
    "prepare": "husky",
    "procore:e2e": "bun packages/providers/scripts/procore-e2e.ts",
    "procore:smoke": "bun packages/providers/scripts/procore-smoke.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc && bun --filter '@safe-edge/*' typecheck"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@safe-edge/contracts": "workspace:*",
    "@safe-edge/sdk": "workspace:*",
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "6.0.3"
  }
}
